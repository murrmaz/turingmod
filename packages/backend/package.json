{
  "name": "@turingmod/backend",
  "version": "0.1.0",
  "description": "TuringMod backend server",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./trpc": {
      "types": "./dist/server/trpc/appRouter.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --build tsconfig.build.json && concurrently -n tsc,run -c blue,green \"tsc --build tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/index.js\"",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src"
  },
  "keywords": [
    "turingmod",
    "backend",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@trpc/server": "11.19.0",
    "@turingmod/shared": "*",
    "@twurple/api": "^8.0.0",
    "@twurple/api-call": "^8.0.0",
    "@twurple/auth": "^8.0.0",
    "@twurple/eventsub-base": "^8.0.0",
    "@twurple/eventsub-ws": "^8.0.0",
    "googleapis": "^185.0.0",
    "obs-websocket-js": "^5.0.7",
    "pino": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.8.1",
    "tsyringe": "^4.10.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.0"
  }
}
