# Copy to .env in the repository root. The backend and the Vite dev server both load it at
# startup; variables already set in the shell take precedence over this file. A setting left
# blank uses its default; one that is set but invalid stops TuringMod at startup, naming it.

# Server
# The backend's one port: console, WebSocket, and the OAuth redirect URIs. Changing it means
# updating the redirect URI registered with each OAuth provider as well.
SERVER_PORT=8080
# Must be loopback: 127.0.0.1 or localhost.
HOST=127.0.0.1

# Database. A relative path resolves against the backend's working directory (packages/backend
# under npm scripts). Defaults to turingmod.db there.
# DB_PATH=./turingmod.db

# Logging: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# The built console the backend serves. Defaults to packages/frontend/dist.
# FRONTEND_DIST_PATH=../frontend/dist

# Required: TuringMod won't start without it. Encrypts the integration credentials it stores.
# Set it before configuring any integration: changing it later makes the credentials already
# stored unreadable, and each integration has to be set up again.
MASTER_PASSWORD=

# OAuth client credentials (Twitch, Spotify, YouTube) don't go here: they're entered in the
# console's setup dialog when an integration is first connected, and stored encrypted.
