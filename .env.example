# Copy to .env in the repository root. The backend and the Vite dev server both load it at
# startup; variables already set in the shell take precedence over this file.

# Server
# The backend's one port: console, WebSocket, and the OAuth redirect URIs. Changing it means
# updating the redirect URI registered with each OAuth provider as well.
SERVER_PORT=8080
# Must be loopback: 127.0.0.1 or localhost.
HOST=127.0.0.1
NODE_ENV=development

# Database. A relative path resolves against the backend's working directory (packages/backend
# under npm scripts). Defaults to turingmod.db there.
# DB_PATH=./turingmod.db

# Logging
LOG_LEVEL=info

# Encryption key for stored integration credentials. Required when NODE_ENV=production.
# Set it before configuring any integration: changing it later makes the credentials already
# stored unreadable, and each integration has to be set up again.
# MASTER_PASSWORD=

# OAuth app credentials, used for first-time setup before any are saved through the console.
# Twitch: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Spotify (optional): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube (optional): https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
